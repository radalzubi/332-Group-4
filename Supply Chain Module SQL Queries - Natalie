CREATE PROCEDURE DisruptionEventsDisplay(
  IN userEnteredName VARCHAR(100),
  IN userEnteredRegion VARCHAR(50), 
  IN userEnteredTier ENUM('1','2','3'),
  IN userStartDate DATE,
  IN userEndDate DATE
)
BEGIN

  WITH dateRange AS (
    SELECT 
      COALESCE(userStartDate, (SELECT MIN(EventDate) FROM DisruptionEvent)) AS disruptionStartDate,
      COALESCE(userEndDate, (SELECT MAX(EventDate) FROM DisruptionEvent)) AS disruptionEndDate
  ),

  disruptionsInRange AS (
    SELECT
      c.CompanyID,
      c.CompanyName,
      c.TierLevel,
      l.ContinentName AS Region,
      de.EventID,
      de.EventDate,
      de.EventRecoveryDate,
      ic.ImpactLevel
    FROM DisruptionEvent de
    JOIN ImpactsCompany ic ON de.EventID = ic.EventID
    JOIN Company c ON ic.AffectedCompanyID = c.CompanyID
    JOIN Location l ON c.LocationID = l.LocationID
    JOIN dateRange dr 
         ON de.EventDate BETWEEN dr.disruptionStartDate AND dr.disruptionEndDate
    WHERE (userEnteredName IS NULL OR c.CompanyName = userEnteredName)
      AND (userEnteredRegion IS NULL OR l.ContinentName = userEnteredRegion)
      AND (userEnteredTier IS NULL OR c.TierLevel = userEnteredTier)
  ),

  totalDisruptions AS (
    SELECT COUNT(*) AS totalDisruptions 
    FROM disruptionsInRange
  )

  /* --- DISTRIBUTION BY CATEGORY --- */
  SELECT 
    dc.CategoryName,
    COUNT(de.EventID) AS EventCount
  FROM DisruptionCategory dc
  LEFT JOIN DisruptionEvent de 
         ON dc.CategoryID = de.CategoryID
  LEFT JOIN ImpactsCompany ic 
         ON de.EventID = ic.EventID
  LEFT JOIN disruptionsInRange d 
         ON ic.EventID = d.EventID
  GROUP BY dc.CategoryName
  ORDER BY EventCount DESC;

  /* --- LIST ALL EVENTS --- */
  SELECT *
  FROM disruptionsInRange
  ORDER BY EventDate DESC;

  /* --- DISRUPTION FREQUENCY --- */
  SELECT 
    CompanyID,
    CompanyName,
    COUNT(*) AS Ndisruptions,
    COUNT(DISTINCT CONCAT(YEAR(EventDate), '-', QUARTER(EventDate))) AS T_quarters,
    COUNT(*) / COUNT(DISTINCT CONCAT(YEAR(EventDate), '-', QUARTER(EventDate))) AS DF
  FROM disruptionsInRange
  GROUP BY CompanyID, CompanyName
  ORDER BY DF DESC;

  /* --- AVERAGE RECOVERY TIME --- */
  SELECT 
    CompanyID,
    CompanyName,
    Region,
    COUNT(*) AS Ndisruptions,
    AVG(DATEDIFF(EventRecoveryDate, EventDate)) AS ART
  FROM disruptionsInRange
  WHERE EventRecoveryDate IS NOT NULL
  GROUP BY CompanyID, CompanyName, Region
  ORDER BY ART ASC;

  /* --- HIGH DISRUPTION RATE --- */
  SELECT
    CompanyID,
    CompanyName,
    Region,
    COUNT(*) AS Ndisruptions,
    SUM(CASE WHEN ImpactLevel = 'High' THEN 1 ELSE 0 END) AS NhighImpact,
    ROUND(100 * SUM(CASE WHEN ImpactLevel = 'High' THEN 1 ELSE 0 END) / COUNT(*), 2) AS HDR
  FROM disruptionsInRange
  GROUP BY CompanyID, CompanyName, Region
  ORDER BY HDR DESC;

  /* --- TOTAL DOWNTIME --- */
  SELECT
    CompanyID,
    CompanyName,
    Region,
    SUM(DATEDIFF(EventRecoveryDate, EventDate)) AS TD
  FROM disruptionsInRange
  WHERE EventRecoveryDate IS NOT NULL
  GROUP BY CompanyID, CompanyName, Region
  ORDER BY TD DESC;

  /* --- REGIONAL RISK CONCENTRATION --- */
  SELECT
    Region,
    COUNT(*) AS disruptionsInRegion,
    ROUND(100 * COUNT(*) / (SELECT totalDisruptions FROM totalDisruptions), 2) AS RRC
  FROM disruptionsInRange
  GROUP BY Region
  ORDER BY RRC DESC;

  /* --- SEVERITY DISTRIBUTION --- */
  SELECT
    ImpactLevel,
    COUNT(*) AS disruptionsCount
  FROM disruptionsInRange
  GROUP BY ImpactLevel
  ORDER BY FIELD(ImpactLevel, 'Low', 'Medium', 'High');

END//

