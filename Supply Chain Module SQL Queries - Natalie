
----- Company Info Search ------

DELIMITER //

CREATE PROCEDURE CompanyInfoSearch( 
  IN userEnteredName VARCHAR(100),
  IN userStartDate DATE,
  IN userEndDate DATE
)
BEGIN

  SELECT * -- company info (searchable by name)
  FROM Company
  WHERE CompanyName = userEnteredName;

  SELECT -- address (city, country, continent)
    c.CompanyID,
    c.CompanyName,
    l.City,
    l.CountryName,
    l.ContinentName
  FROM Company c
  JOIN Location l ON c.LocationID = l.LocationID
  WHERE c.CompanyName = userEnteredName;

  SELECT -- who they depend on, and who depends on them
    c.CompanyID AS BaseCompanyID, -- searched company
    depUp.CompanyID AS UpstreamCompanyID, 
    depUp.CompanyName AS UpstreamCompanyName, -- has dependent(s)
    depDown.CompanyID AS DownstreamCompanyID,
    depDown.CompanyName AS DownstreamCompanyName -- is dependent
  FROM Company c
  LEFT JOIN DependsOn d1 ON c.CompanyID = d1.DownstreamCompanyID
  LEFT JOIN Company depUp ON d1.UpstreamCompanyID = depUp.CompanyID -- dependent companies on searched company
  LEFT JOIN DependsOn d2 ON c.CompanyID = d2.UpstreamCompanyID
  LEFT JOIN Company depDown ON d2.DownstreamCompanyID = depDown.CompanyID -- companies that searched company depends on
  WHERE c.CompanyName = userEnteredName;

  SELECT f.* -- most recent financial status
  FROM FinancialReport f
  JOIN Company c ON f.CompanyID = c.CompanyID
  WHERE c.CompanyName = userEnteredName
  ORDER BY f.RepYear DESC, FIELD(f.Quarter, 'Q4','Q3','Q2','Q1') DESC -- latest year and quarter
  LIMIT 1; -- most recent

  SELECT -- capacity (if manufacturer)
      c.CompanyName,
      m.FactoryCapacity AS TotalCapacity
  FROM Company c
  JOIN Manufacturer m ON c.CompanyID = m.CompanyID
  WHERE c.CompanyName = userEnteredName;

  SELECT -- unique routes operated (if distirbutor)
      c.CompanyName,
      COUNT(DISTINCT CONCAT(s.SourceCompanyID, '->', s.DestinationCompanyID)) AS UniqueRoutes
  FROM Company c
  JOIN Distributor d ON c.CompanyID = d.CompanyID
  JOIN Shipping s ON d.CompanyID = s.DistributorID
  WHERE c.CompanyName = userEnteredName
  GROUP BY c.CompanyName;

  SELECT -- which products they supply
    p.ProductID,
    p.ProductName,
    sp.SupplyPrice
  FROM SuppliesProduct sp
  JOIN Product p ON sp.ProductID = p.ProductID
  JOIN Company c ON sp.SupplierID = c.CompanyID
  WHERE c.CompanyName = userEnteredName;

  SELECT -- the diversity of products (based on Piazza question 215: "A3 - Supply Chain Manager Module - Diversity of Products Clarification")
    p.Category,
    COUNT(*) AS TotalProductNumber,
    ROUND(
      COUNT(*) * 100.0 / (
        SELECT COUNT(*) FROM SuppliesProduct sp2
        JOIN Company c2 ON sp2.SupplierID = c2.CompanyID
        WHERE c2.CompanyName = userEnteredName
      ), 4
    ) AS PercentOfTotalProducts
  FROM SuppliesProduct sp
  JOIN Product p ON sp.ProductID = p.ProductID
  JOIN Company c ON sp.SupplierID = c.CompanyID
  WHERE c.CompanyName = userEnteredName
  GROUP BY p.Category;

  SELECT -- list of shipping transactions
    t.TransactionID,
    'Shipping' AS TransactionType,
    s.SourceCompanyID,
    s.DestinationCompanyID,
    s.Quantity,
    s.ActualDate AS TransactionDate,
    p.ProductName
  FROM InventoryTransaction t
  JOIN Shipping s ON t.TransactionID = s.TransactionID
  JOIN Product p ON s.ProductID = p.ProductID
  JOIN Company c ON (s.SourceCompanyID = c.CompanyID OR s.DestinationCompanyID = c.CompanyID)
  WHERE c.CompanyName = userEnteredName AND s.ActualDate BETWEEN COALESCE(userStartDate, '1000-01-01') AND COALESCE(userEndDate, CURRENT_DATE)
  ORDER BY s.ActualDate DESC;

  SELECT -- list of receiving transactions
    t.TransactionID,
    'Receiving' AS TransactionType,
    r.ReceivedDate AS TransactionDate,
    r.QuantityReceived AS Quantity,
    r.ReceiverCompanyID,
    s.SourceCompanyID,
    p.ProductName
  FROM InventoryTransaction t
  JOIN Receiving r ON t.TransactionID = r.TransactionID
  JOIN Shipping s ON r.ShipmentID = s.ShipmentID
  JOIN Product p ON s.ProductID = p.ProductID
  JOIN Company c ON r.ReceiverCompanyID = c.CompanyID
  WHERE c.CompanyName = userEnteredName AND r.ReceivedDate BETWEEN COALESCE(userStartDate, '1000-01-01') AND COALESCE(userEndDate, CURRENT_DATE)
  ORDER BY r.ReceivedDate DESC;

  SELECT -- list of adjustment transactions
    t.TransactionID,
    'Adjustment' AS TransactionType,
    a.AdjustmentDate,
    a.QuantityChange,
    a.CompanyID,
    p.ProductName,
    a.Reason
  FROM InventoryTransaction t
  JOIN InventoryAdjustment a ON t.TransactionID = a.TransactionID
  JOIN Product p ON a.ProductID = p.ProductID
  JOIN Company c ON a.CompanyID = c.CompanyID
  WHERE c.CompanyName = userEnteredName AND a.AdjustmentDate BETWEEN COALESCE(userStartDate, '1000-01-01') AND COALESCE(userEndDate, CURRENT_DATE)
  ORDER BY a.AdjustmentDate DESC;

  WITH distributorShipments AS ( -- Key Performance Indicators (within date range)
    SELECT
      s.ShipmentID,
      s.PromisedDate,
      s.ActualDate,
      DATEDIFF(s.ActualDate, s.PromisedDate) AS daysDelayed
    FROM Shipping s
    JOIN Company c ON s.DistributorID = c.CompanyID
    WHERE c.CompanyName = userEnteredName AND c.Type = 'Distributor' AND s.ActualDate BETWEEN COALESCE(userStartDate, '1000-01-01') AND COALESCE(userEndDate, CURRENT_DATE)
  )

  SELECT 
    c.CompanyName,
    c.Type AS CompanyType,

    CASE -- on time delivery rate (from Piazza question 223 only for distributors)
      WHEN c.Type = 'Distributor' THEN (
        SELECT ROUND(
          100.0 * SUM(CASE WHEN ActualDate <= PromisedDate THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0),
          4
        )
        FROM distributorShipments
      )
      ELSE NULL
    END AS OnTimeDeliveryRate,

    CASE -- average of delay: based on difference between delivery and promised dates (from Piazza question 223 only for distributors)
      WHEN c.Type = 'Distributor' THEN (
        SELECT ROUND(AVG(daysDelayed), 4)
        FROM distributorShipments
      )
      ELSE NULL
    END AS AverageDelay,

    CASE -- standard deviation of delay: based on difference between delivery and promised dates (from Piazza question 223 only for distributors)
      WHEN c.Type = 'Distributor' THEN (
        SELECT ROUND(STDDEV_POP(daysDelayed), 4)
        FROM distributorShipments
      )
      ELSE NULL
    END AS StandardDeviationDelay

  FROM Company c
  WHERE c.CompanyName = userEnteredName;

  WITH LastFourQuarters AS ( -- finding the four quarters counting back a year ago from today
    SELECT
      CONCAT('Q', MOD(QUARTER(CURDATE()) - n - 1 + 4, 4) + 1) AS Quarter,
      YEAR(CURDATE()) - IF(QUARTER(CURDATE()) - n <= 0, 1, 0) AS RepYear
    FROM (
      SELECT 0 AS n UNION ALL 
      SELECT 1 UNION ALL 
      SELECT 2 UNION ALL 
      SELECT 3
    ) AS offsets
  )

  SELECT -- financial health status over past year from today
    c.CompanyName,
    fr.CompanyID,
    fr.Quarter,
    fr.RepYear,
    fr.HealthScore
  FROM FinancialReport fr
  JOIN LastFourQuarters lfq ON fr.RepYear = lfq.RepYear AND fr.Quarter = lfq.Quarter
  JOIN Company c ON fr.CompanyID = c.CompanyID
  WHERE c.CompanyName = userEnteredName
  ORDER BY fr.RepYear DESC, fr.Quarter DESC;

  SELECT -- distribution of disruption event counts over past year
    dc.CategoryName,
    COUNT(de.EventID) AS EventCount
  FROM DisruptionCategory dc
  LEFT JOIN DisruptionEvent de ON dc.CategoryID = de.CategoryID AND de.EventDate >= DATE_SUB(CURDATE(), INTERVAL 1 YEAR)
  GROUP BY dc.CategoryName
  ORDER BY EventCount DESC;

  SELECT -- a list of the disruption events
    dc.CategoryID,
    dc.CategoryName, 
    dc.Description,
    de.EventID,
    de.EventDate,
    de.EventRecoveryDate
  FROM DisruptionEvent de
  JOIN DisruptionCategory dc ON de.CategoryID = dc.CategoryID
  WHERE de.EventDate >= DATE_SUB(CURDATE(), INTERVAL 1 YEAR)
  ORDER BY de.EventDate DESC;

END //

DELIMITER ;


---- Disruption Events (by company, region, tier, over period of time) ----

DELIMITER //

CREATE PROCEDURE DisruptionEventsDisplay(
  IN userEnteredName VARCHAR(100),
  IN userEnteredRegion VARCHAR(50), 
  IN userEnteredTier ENUM('1','2','3'),
  IN userStartDate DATE,
  IN userEndDate DATE
)
BEGIN

  WITH dateRange AS (
    SELECT 
      COALESCE(userStartDate, (SELECT MIN(EventDate) FROM DisruptionEvent)) AS disruptionStartDate,
      COALESCE(userEndDate, (SELECT MAX(EventDate) FROM DisruptionEvent)) AS disruptionEndDate
  ),

  disruptionsInRange AS (
    SELECT
      c.CompanyID,
      c.CompanyName,
      c.TierLevel,
      l.ContinentName AS Region,
      de.EventID,
      de.EventDate,
      de.EventRecoveryDate,
      ic.ImpactLevel
    FROM DisruptionEvent de
    JOIN ImpactsCompany ic ON de.EventID = ic.EventID
    JOIN Company c ON ic.AffectedCompanyID = c.CompanyID
    JOIN Location l ON c.LocationID = l.LocationID
    JOIN dateRange dr ON de.EventDate BETWEEN dr.disruptionStartDate AND dr.disruptionEndDate
    WHERE (userEnteredName IS NULL OR c.CompanyName = userEnteredName) AND (userEnteredRegion IS NULL OR l.ContinentName = userEnteredRegion) AND (userEnteredTier IS NULL OR c.TierLevel = userEnteredTier)
  ),

  totalDisruptions AS (
    SELECT COUNT(*) AS totalDisruptions 
    FROM disruptionsInRange
  )

  SELECT -- disruptions by category
    dc.CategoryName,
    COUNT(de.EventID) AS EventCount
  FROM DisruptionCategory dc
  LEFT JOIN DisruptionEvent de ON dc.CategoryID = de.CategoryID
  LEFT JOIN ImpactsCompany ic ON de.EventID = ic.EventID
  LEFT JOIN disruptionsInRange d ON ic.EventID = d.EventID
  GROUP BY dc.CategoryName
  ORDER BY EventCount DESC;

  SELECT * -- all disruption events over time period
  FROM disruptionsInRange
  ORDER BY EventDate DESC;

  SELECT -- Disruption Frequency (DF), by company as bar chart
    CompanyID,
    CompanyName,
    COUNT(*) AS Ndisruptions,
    COUNT(DISTINCT CONCAT(YEAR(EventDate), '-', QUARTER(EventDate))) AS T_quarters,
    COUNT(*) / COUNT(DISTINCT CONCAT(YEAR(EventDate), '-', QUARTER(EventDate))) AS DF -- how often disruptions occur for a company or across a network
  FROM disruptionsInRange
  GROUP BY CompanyID, CompanyName
  ORDER BY DF DESC;

  SELECT -- Average Recovery Time (ART), histogram
    CompanyID,
    CompanyName, -- affected company
    Region, -- affected region
    COUNT(*) AS Ndisruptions,
    AVG(DATEDIFF(EventRecoveryDate, EventDate)) AS ART -- how long on average for affected node to return to normal
  FROM disruptionsInRange
  WHERE EventRecoveryDate IS NOT NULL
  GROUP BY CompanyID, CompanyName, Region
  ORDER BY ART ASC;

  SELECT -- High-Impact Disruption Rate (HDR)
    CompanyID,
    CompanyName,
    Region,
    COUNT(*) AS Ndisruptions,
    SUM(CASE WHEN ImpactLevel = 'High' THEN 1 ELSE 0 END) AS NhighImpact,
    ROUND(100 * SUM(CASE WHEN ImpactLevel = 'High' THEN 1 ELSE 0 END) / COUNT(*), 2) AS HDR -- share of disruptions classified as high severity
  FROM disruptionsInRange
  GROUP BY CompanyID, CompanyName, Region
  ORDER BY HDR DESC;

  SELECT -- Total Downtime (TD), histogram
    CompanyID,
    CompanyName,
    Region,
    SUM(DATEDIFF(EventRecoveryDate, EventDate)) AS TD -- aggregate of downtime across all disruptions for given company/region
  FROM disruptionsInRange
  WHERE EventRecoveryDate IS NOT NULL
  GROUP BY CompanyID, CompanyName, Region
  ORDER BY TD DESC;

  SELECT -- Regional Risk Concentration (RRC), heatmap
    Region,
    COUNT(*) AS disruptionsInRegion,
    ROUND(100 * COUNT(*) / (SELECT totalDisruptions FROM totalDisruptions), 2) AS RRC -- fraction of disruptions occuring in a region
  FROM disruptionsInRange
  GROUP BY Region
  ORDER BY RRC DESC;

  SELECT -- Disruption Severity Distribution, stacked bar chart
    ImpactLevel,
    COUNT(*) AS disruptionsCount
  FROM disruptionsInRange
  GROUP BY ImpactLevel
  ORDER BY FIELD(ImpactLevel, 'Low', 'Medium', 'High'); -- counts of low/medium/high severity events

END//

DELIMITER ;

---- Alerts On Screen for New/Ongoing Disruptions ----

CREATE PROCEDURE AlertsOngoingDisruptions()
BEGIN 
  SELECT
    c.CompanyName,
    de.EventID,
    de.EventDate AS StartDate,
    dc.CategoryName
  FROM DisruptionEvent de
  JOIN DisruptionCategory dc ON de.CategoryID = dc.CategoryID
  JOIN ImpactsCompany ic ON de.EventID = ic.EventID
  JOIN Company c ON ic.AffectedCompanyID = c.CompanyID 
  WHERE de.EventRecoveryDate IS NULL OR de.EventRecoveryDate > CURRENT_DATE() -- added event recovery date after current date because disruption event w/ ID of 15 end 11/01/2025 (during A3)
  ORDER BY de.EventDate DESC;
END//

DELIMITER ;

----- Ability to Examine All Transactions (within time range or location, any leaving specific company or arriving at) ---

DELIMITER $$

CREATE PROCEDURE TransactionsExamination(
  IN userStartDate DATE,
  IN userEndDate DATE,
  IN userLocation VARCHAR(100),
  IN userSourceCompany VARCHAR(100), -- leaving company
  IN userDestinationCompany VARCHAR(100), --- arriving company
  IN userDistributor VARCHAR(100) -- distributing company
)

BEGIN

  WITH dateRange AS (
    SELECT
      COALESCE(userStartDate, (SELECT MIN(ActualDate) FROM Shipping)) AS startDate,
      COALESCE(userEndDate,   (SELECT MAX(ActualDate) FROM Shipping)) AS endDate
  ),

  shipments AS (
    SELECT
      s.ShipmentID,
      s.DistributorID,
      d.CompanyName AS DistributorName,
      s.ProductID,
      p.ProductName,
      p.Category,
      s.SourceCompanyID,
      cs.CompanyName AS SourceCompany,
      cs.LocationID AS SourceLocation,
      ls.CountryName AS SourceCountry,
      ls.ContinentName AS SourceRegion,
      ls.CityName AS SourceCity,
      s.DestinationCompanyID,
      cd.CompanyName AS DestinationCompany,
      cd.LocationID AS DestinationLocation,
      ld.CountryName AS DestinationCountry,
      ld.ContinentName AS DestinationContinent,
      ld.CityName AS DestinationCity,
      s.ActualDate,
      s.PromisedDate,
      s.Quantity
    FROM Shipping s
    JOIN Company d  ON s.DistributorID = d.CompanyID
    JOIN Product p  ON s.ProductID = p.ProductID
    JOIN Company cs ON s.SourceCompanyID = cs.CompanyID
    JOIN Company cd ON s.DestinationCompanyID = cd.CompanyID
    JOIN Location ls ON cs.LocationID = ls.LocationID
    JOIN Location ld ON cd.LocationID = ld.LocationID
    CROSS JOIN dateRange dr
    WHERE s.ActualDate BETWEEN dr.startDate AND dr.endDate AND (userSourceCompany IS NULL OR cs.CompanyName = userSourceCompany) AND (userDestinationCompany IS NULL OR cd.CompanyName = userDestinationCompany) AND (userDistributor IS NULL OR d.CompanyName = userDistributor) AND (userLocation IS NULL OR ls.CountryName = userLocation OR ls.ContinentName = userLocation OR ls.CityName = userLocation OR ld.CountryName = userLocation OR ld.ContinentName = userLocation OR ld.CityName = userLocation)
  ),

  receivings AS (
    SELECT
      r.ReceivingID,
      r.TransactionID,
      r.ShipmentID,
      r.ReceiverCompanyID,
      c.CompanyName AS ReceiverCompany,
      r.ReceivedDate,
      r.QuantityReceived,
      s.SourceCompanyID,
      s.DestinationCompanyID,
      s.DistributorID,
      s.ProductID,
      s.ActualDate
    FROM Receiving r
    JOIN Shipping s ON r.ShipmentID = s.ShipmentID
    JOIN Company c   ON r.ReceiverCompanyID = c.CompanyID
    CROSS JOIN dateRange dr
    WHERE s.ActualDate BETWEEN dr.startDate AND dr.endDate AND (userSourceCompany IS NULL OR s.SourceCompanyID = (SELECT CompanyID FROM Company WHERE CompanyName = userSourceCompany LIMIT 1)) AND (userDestinationCompany IS NULL OR r.ReceiverCompanyID = (SELECT CompanyID FROM Company WHERE CompanyName = userDestinationCompany LIMIT 1)) AND (userDistributor IS NULL OR s.DistributorID = (SELECT CompanyID FROM Company WHERE CompanyName = userDistributor LIMIT 1))
  ),

  adjustments AS (
    SELECT
      a.AdjustmentID,
      a.TransactionID,
      a.CompanyID,
      c.CompanyName,
      a.ProductID,
      p.ProductName,
      a.AdjustmentDate,
      a.QuantityChange,
      a.Reason
    FROM InventoryAdjustment a
    JOIN Company c ON a.CompanyID = c.CompanyID
    JOIN Product p ON a.ProductID = p.ProductID
    CROSS JOIN dateRange dr
    WHERE a.AdjustmentDate BETWEEN dr.startDate AND dr.endDate AND (userSourceCompany IS NULL OR a.CompanyID = (SELECT CompanyID FROM Company WHERE CompanyName = userSourceCompany LIMIT 1)) AND (userDestinationCompany IS NULL OR a.CompanyID = (SELECT CompanyID FROM Company WHERE CompanyName = userDestinationCompany LIMIT 1)) AND (userDistributor IS NULL OR a.CompanyID = (SELECT CompanyID FROM Company WHERE CompanyName = userDistributor LIMIT 1))
  ),

  statusOfShipments AS (
    SELECT
      s.*,
      CASE
        WHEN s.ActualDate IS NULL THEN 'Currently Out on Delivery'
        WHEN s.ActualDate <= s.PromisedDate THEN 'On Time Delivery'
        ELSE 'Late Delivery'
      END AS DeliveryStatus,
      DATEDIFF(s.ActualDate, s.PromisedDate) AS daysDelayed
    FROM shipments s
  ),

  productsHandled AS (
    SELECT
      s.DistributorID,
      s.DistributorName,
      s.ProductID,
      s.ProductName,
      s.Category,
      sp.SupplyPrice,
      COUNT(*)                 AS NumShipments,
      SUM(s.Quantity)          AS TotalQuantity
    FROM statusOfShipments s
    LEFT JOIN Product p ON s.ProductID = p.ProductID
    LEFT JOIN SuppliesProduct sp ON sp.ProductID = s.ProductID AND sp.SupplierID = s.DistributorID
    GROUP BY s.DistributorID, s.DistributorName, s.ProductID, s.ProductName, s.Category, sp.SupplyPrice
  ),

  findDisruptionExposure AS ( -- total disruptions + 2*high impact events
    SELECT
      d.CompanyID,
      d.CompanyName,
      COUNT(DISTINCT de.EventID) AS Ndisruptions,
      (COUNT(DISTINCT de.EventID) + 2 * COALESCE(SUM(CASE WHEN ic.ImpactLevel = 'High' THEN 1 ELSE 0 END),0)) AS disruptionExposure
    FROM Distributor d
    LEFT JOIN ImpactsCompany ic ON d.CompanyID = ic.AffectedCompanyID
    LEFT JOIN DisruptionEvent de ON ic.EventID = de.EventID
    CROSS JOIN dateRange dr
    WHERE (de.EventDate BETWEEN dr.startDate AND dr.endDate OR de.EventDate IS NULL)
    GROUP BY d.CompanyID, d.CompanyName
  )

  SELECT 
    'Shipping' AS TransactionType,
    s.ShipmentID AS ShipmentID,
    NULL AS ReceivingID,
    NULL AS AdjustmentID,
    s.DistributorID,
    s.DistributorName,
    s.ProductID,
    s.ProductName,
    s.SourceCompanyID,
    s.SourceCompany,
    s.DestinationCompanyID,
    s.DestinationCompany,
    s.ActualDate AS EventDate,
    NULL AS ReceivedDate,
    NULL AS AdjustmentDate,
    s.Quantity AS Quantity,
    NULL AS QuantityReceived,
    NULL AS QuantityChange,
    s.DeliveryStatus,
    s.daysDelayed
  FROM statusOfShipments s

  UNION ALL

  SELECT
    'Receiving' AS TransactionType,
    r.ShipmentID,
    r.ReceivingID,
    NULL, -- no adjustment ID in the receiving table
    r.DistributorID,
    NULL, -- no distributor name in the receiving table
    r.ProductID,
    NULL, -- no product name in the receiving table
    r.SourceCompanyID,
    NULL, -- no source company name in the receiving table
    r.DestinationCompanyID,
    NULL, -- no destination company name in the receiving table
    r.ActualDate AS EventDate,
    r.ReceivedDate,
    NULL, -- no adjustment date
    NULL, -- no adjustment quantity
    r.QuantityReceived,
    NULL, -- adjustment quantity change
    NULL, -- DeliveryStatus
    NULL -- daysDelayed
  FROM receivings r

  UNION ALL

  SELECT
    'Adjustment' AS TransactionType,
    NULL AS ShipmentID,
    NULL AS ReceivingID,
    a.AdjustmentID,
    a.CompanyID AS DistributorID,
    a.CompanyName AS DistributorName,
    a.ProductID,
    a.ProductName,
    NULL, -- source company
    NULL, -- destination company
    NULL, -- actual date
    NULL, -- received date
    a.AdjustmentDate AS EventDate,
    NULL, -- ReceivedDate
    a.AdjustmentDate AS AdjustmentDate,
    NULL, -- Quantity Shipped
    NULL, -- Quantity Received
    a.QuantityChange,
    NULL, -- DeliveryStatus
    NULL  -- daysDelayed
  FROM adjustments a

  ORDER BY TransactionType, EventDate, ReceivedDate, AdjustmentDate;

  IF userDistributor IS NOT NULL THEN -- for distributor-specific details about transactions

    SELECT
      ph.DistributorName,
      COUNT(DISTINCT s.ShipmentID) AS shipmentCount,
      COALESCE(SUM(s.Quantity),0) AS shipmentVolume, -- shipment volume
      ROUND(100 * COALESCE(SUM(CASE WHEN s.DeliveryStatus = 'On Time Delivery' THEN 1 ELSE 0 END),0) / GREATEST(COUNT(*),1), 4) AS onTimeDeliveryRate_pct, -- on-time delivery rate (as percent)
      SUM(CASE WHEN s.DeliveryStatus = 'Currently Out on Delivery' THEN 1 ELSE 0 END) AS shipmentsOutOnDelivery, -- which products are currently out part of status distribution
      SUM(CASE WHEN s.DeliveryStatus = 'Late Delivery' THEN 1 ELSE 0 END) AS lateShipments, -- which products were delivered late part of status distribution
      SUM(CASE WHEN s.DeliveryStatus = 'On Time Delivery' THEN 1 ELSE 0 END) AS onTimeShipments -- which products were delivered on time part of status distribution
    FROM statusOfShipments s
    JOIN productsHandled ph ON ph.DistributorID = s.DistributorID
    WHERE ph.DistributorName = userDistributor
    GROUP BY ph.DistributorName;

    SELECT -- products handled
      ph.ProductName,
      ph.Category,
      ph.SupplyPrice,
      ph.NumShipments,
      ph.TotalQuantity,
      (ph.SupplyPrice * ph.TotalQuantity) AS TotalRevenuePerProduct
    FROM productsHandled ph
    WHERE ph.DistributorName = userDistributor
    ORDER BY ph.ProductName;

    SELECT -- disruption exposure
      f.CompanyName,
      f.Ndisruptions,
      f.disruptionExposure
    FROM findDisruptionExposure f
    WHERE f.CompanyName = userDistributor;

    SELECT -- number of shipments per category (for first useful plot)
      ph.Category,
      SUM(ph.NumShipments) AS NumShipments,
      SUM(ph.TotalQuantity) AS TotalQuantity
    FROM productsHandled ph
    WHERE ph.DistributorName = userDistributor
    GROUP BY ph.Category
    ORDER BY ph.Category;

    SELECT -- revenue per category (for second useful plot)
      ph.Category,
      SUM(COALESCE(ph.SupplyPrice,0) * ph.TotalQuantity) AS TotalRevenue
    FROM productsHandled ph
    WHERE ph.DistributorName = userDistributor
    GROUP BY ph.Category
    ORDER BY TotalRevenue DESC;

    SELECT -- price distribution of products handled (for third useful plot)
      ph.ProductName,
      ph.Category,
      ph.SupplyPrice,
      ph.TotalQuantity
    FROM productsHandled ph
    WHERE ph.DistributorName = userDistributor
    ORDER BY ph.SupplyPrice ASC;

   SELECT -- disruption events by category (for fourth useful plot)
      dc.CategoryName AS EventCategory,
      COUNT(DISTINCT de.EventID) AS NumEvents,
      SUM(CASE WHEN ic.ImpactLevel = 'High' THEN 1 ELSE 0 END) AS NumHighImpactEvents
    FROM Distributor d
    LEFT JOIN ImpactsCompany ic ON d.CompanyID = ic.AffectedCompanyID
    LEFT JOIN DisruptionEvent de ON ic.EventID = de.EventID
    LEFT JOIN DisruptionCategory dc ON de.CategoryID = dc.CategoryID
    CROSS JOIN dateRange dr
    WHERE d.CompanyName = userDistributor AND de.EventDate BETWEEN dr.startDate AND dr.endDate
    GROUP BY dc.CategoryName
    ORDER BY NumEvents DESC;

  END IF;

END$$

DELIMITER ;







