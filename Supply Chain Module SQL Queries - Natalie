DELIMITER //

-- COMPANY SEARCH contains Important Company Info and Key Performance Indicators --
  -- mandatory input of company name, optional input of date range (start date and end date)--

-- Important Company Info (subcategory of COMPANY SEARCH) -- 

CREATE PROCEDURE CompanyInfoSearch( -- Company Info
  IN userEnteredName VARCHAR(100), -- searchable by name
  IN userStartDate DATE DEFAULT NULL, -- needed for date range for transactions
  IN userEndDate DATE DEFAULT NULL -- needed for date range for transaction
)
BEGIN

  SELECT c.* -- all columns in Company since either listed in A3 requirements (Location ID for address, Tier Level, and Company Type) or justifiable as important information (Company ID)
  FROM Company c
  WHERE c.Name = userEnteredName;

  SELECT -- address
    c.CompanyID,
    c.CompanyName,
    l.City,
    l.CountryName,
    l.ContinentName
  FROM Company c
  JOIN location l ON l.locationID = c.LocationID
  WHERE c.CompanyName = userEnteredName;

  SELECT -- who they depend on, and who depends on them
    c.CompanyID,
    depUp.CompanyID,
    depUp.Name,
    depDown.CompanyID,
    depDown.Name
  FROM Company C
  LEFT JOIN DependsOn d1 ON c.CompanyID = d1.DownstreamCompanyID -- all results from DependsOn table (d1 link table version) to corresponding company IDs where searched company is downstream (searched depends on said companies)
  LEFT JOIN Company depUp ON d1.UpstreamCompanyID = depUp.CompanyID -- all results from Company depUp and their corresponding IDs paired with searched company ID downstream of them
  LEFT JOIN DependsOn d2 ON c.CompanyID - d2.UpstreamCompanyID -- all results from DependsOn link table d2 to corresponding company IDs where searched company is upstream (said companies depend on searched)
  LEFT JOIN Company depDown ON d2.DownstreamCompanyID = depDown.CompanyID -- all reuslts from Company depDown and their corresponding IDs paired with searched company ID upstream of them
  WHERE c.Name - userEnteredName;

  SELECT f.* -- assumption that "most recent financial status" must include all FinancialReport data (Quarter, RepYear, HealthScore)
  FROM FinancialReport f
  JOIN Company C ON f.CompanyID = c.CompanyID
  WHERE c.Name = userEnteredName
  ORDER BY (f.RepYear DESC, -- starting most recent (latest) year
    FIELD(f.Quarter, 'Q4', 'Q3', 'Q2', 'Q1') DESC -- starting most recent (latest) quarter
  LIMIT 1;

  SELECT -- capacity (if manufacturer)
    m.CompanyID,
    m.FactoryCapacity
  FROM Manufacturer m
  JOIN Company ON c.CompanyID = m.CompanyID
  WHERE c.CompanyName = userEnteredName;

  SELECT -- unique routes (if distributor) 
    d.CompanyID, -- Distributor table only contains IDs corresponding to companyIDs in full Company table that belong to distributors
    DISTINCT o.FromCompanyID, -- The pairing of From Company ID &
    o.ToCompanyID, -- ToCompanyID needs to be distinct in order for the route to be unique
  FROM Distributor d
  JOIN Company c ON c.CompanyID = d.CompanyID
  LEFT JOIN OperatesLogistics o ON o.DistributorID = d.CompanyID
  WHERE c.CompanyName = userEnteredName;

  SELECT -- which products they supply (assumption that product price is important info to be included)
    p.ProductID,
    p.ProductName,
    sp.SupplyPrice
  FROM SuppliesProduct sp
  JOIN Product p ON sp.ProductID = p.ProductID
  JOIN Company c ON sp.SupplierID = c.CompanyID
  WHERE c.CompanyName = userEnteredName;

  SELECT -- the diversity of products (from Piazza "A3 - Supply Chain Manager Module - Diversity of Products Clarification" taken to mean diversity between product categories)
    p.Category,
    COUNT(p.ProductID) AS TotalProductNumber, -- total quantity of all products
    COUNT(p.ProductID) * 100.00 / ( -- percentage
      SELECT COUNT(*)
      FROM SuppliesProduct supr
      WHERE supr.SupplierID = c.CompanyID -- of specific product
    ) AS PercentOfTotalProducts -- individual product percentage out of all products
  FROM SuppliesProduct sp
  JOIN Product p ON sp.ProductID = p.ProductID
  JOIN Company c ON sp.SupplierID = c.CompanyID
  WHERE c.CompanyName = userEnteredName
  GROUP BY p.Category; -- category percentage out of all products

  SELECT -- shipping transactions (within date range)
    t.TransactionID AS OrderID,
    'Shipping' AS TransactionType, -- where a product is shipped to or shipped from a company (due to nature of the Shipping table)
    s.SourceCompanyID, -- can be target company
    s.DestinationCompanyID, -- can be target company
    s.Quantity,
    s.ActualDate AS TransactionDate, -- using actual shipped not promised
    p.ProductName
  FROM Inventory Transaction t
  JOIN Shipping s on t.TransactionID = s.TransactionID
  JOIN Product p on s.ProductID = p.ProductID
  JOIN Company c ON (s.SourceCompanyID = c.CompanyID OR s.DesinationCompanyID = c.CompanyID) -- shows both shipped from (source company) and shipped to (destination company) transactions attached to search company
  WHERE c.CompanyName = userEnteredName AND (s.ActualDate BETWEEN COALESCE(userStartDate, '1000-01-01') AND COALESCE(userEndDate, CURRENT_DATE) -- lists all shipments if no date range specified, lists shipments between date ends if specified
  ORDER BY s.ActualDatel; -- chronological order from most recent

  SELECT -- receiving transaction (within date range)
    t.TransactionID AS OrderID,
    'Receiving' AS TransactionType, -- where a product is received by a company (due to nature of Receiving table) 
    r.ReceivedDate AS TransactionDate,
    r.QuantityReceived AS Quantity,
    r.ReceiverCompanyID AS DestinationCompanyID, -- target company, kept naming for convention with shipping transactions
    s.SourceCompanyID, -- included in transaction description
    p.ProductName
  FROM Inventory Transaction t
  JOIN Receiving r ON t.TransactionID = r.TransactionID -- 
  JOIN Shipping s ON r.ShipmentID = s.ShipmentID -- to display source company (not the target company) of the product
  JOIN Product p ON s.ProductID = p.ProductID
  JOIN Company c ON r.ReceiverCompanyID = c.CompanyID
  WHERE c.CompanyName = userEnteredName AND (r.ReceivedDate BETWEEN COALESCE(userStartDate, '1000-01-01') AND COALESCE(userEndDate, CURRENT_DATE) -- lists all transactions if no date range specified, lists transactions between date ends if specified
  ORDER BY r.ReceivedDate; -- chronological order from most recent

  SELECT -- adjustment transactions (within date range)
    t.TransactionID AS OrderID,
    'Adjustment' AS TransactionType,
    a.AdjustmentDate AS TransactionDate,
    a.QuantityChange AS Quantity,
    a.CompanyID AS SourceCompanyID, -- target company, kept naming for convention with shipping (and receiving) transactions
    a.CompanyID AS DestinationCompanyID, -- target company, same as above
    p.ProductName,
    a.Reason
  FROM InventoryTransaction t
  JOIN InventoryAdjustment a ON t.TransactionID = a.TransactionID
  JOIN Product p ON a.ProductID = p.ProductID
  JOIN Company c ON a.CompanyID = c.CompanyID -- merges source/destination since adjustments all internal
  WHERE c.CompanyName = userEnteredName AND (a.AdjustmentDate BETWEEN COALESCE(userStartDate, '1000-01-01') AND COALESCE(userEndDate, CURRENT_DATE) -- lists all adjustments if no date range specified, lists adjustments between date ends if specified
  ORDER BY a.AdjustmentDate; -- chronological order from most recent


-- Key Performance Indicators (subcategory of COMPANY SEARCH)-- 
-- only applicable to distributors, non-distributor company entered then returns the default null --

  WITH dateRange AS ( -- only for user-input (first two A3 KPI bullet points only (on time delivery rate, average and standard deviation of delay))
    SELECT 
      COALESCE (userStartDate, (SELECT MIN(ActualDate) FROM Shipping)) AS startDate,
      COALESCE

  distributorShipments AS (
    SELECT
      s.ShipmentID,
      s.PromisedDate,
      s.ActualDate,
      DATEDIFF(s.ActualDate, s.PromisedDate) AS daysDelayed
  FROM Shipping s
  JOIN Company c ON s.DistributorID = c.CompanyID
  WHERE c.CompanyName = userEnteredName AND c.Type = 'Distributor' AND (s.ActualDate BETWEEN COALESCE(userStartDate, '1000-01-01') AND COALESCE(userEndDate, CURRENT_DATE)  -- all shipments if no date range specified, shipments between date ends if specified


  SELECT -- on time delivery rate, (percentage shipments where delivery date before or equal to promised date), average delay, standard deviation of delay
    c.Type AS CompanyType,

    CASE -- on time delivery rate: percentage shipments where delivery date <= promised date
      WHEN c.Type = 'Distributor' THEN (
        SELECT
          ROUND( 100 * SUM(CASE WHEN Actual Date <= PromisedDate THEN 1 ELSE 0 END) / COUNT(*), 4)
        FROM distributorShipments
      )
      ELSE NULL
    END AS onTimeDeliveryRate.

    CASE -- average of delay
      WHEN c.Type = 'Distributor' THEN (
        SELECT ROUND(AVG(daysDelayed), 4) 
        FROM distributorShipments
      )
      ELSE NULL
    END AS averageDelay,

    CASE -- standard deviation of delay
      WHEN c.Type = 'Distributor' THEN (
        SELECT ROUND(STDDEV(daysDelayed), 4)
        FROM distributorShipments
      )
      ELSE NULL
    END AS standardDeviationDelay

  FROM Company c;
  
  
  WITH LastFourQuarters AS ( -- most recent four quarters calculated (last two A3 KPI bullet points (financial health status and distribution/list of disruption events) one year from current date
    SELECT
      MOD(QUARTER(CURDATE()) - n - 1 + 4, 4) + 1 AS QuarterCycled, -- subtracting offsets four times, stays within 1-4 range (1 subtracts down to 4)
      YEAR(CURDATE()) - IF(QUARTER(CURDATE()) - n <=0, 1, 0) AS RepYear -- once/if quarter 1 subtracts to 4 then goes to previous year
    FROM
      SELECT 0 AS n UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3
    ) AS offsets
  )

  SELECT -- financial health status over past year from today
    c.CompanyName,
    fr.CompanyID,
    fr.Quarter,
    fr.RepYear,
    fr.HealthScore
  FROM FinancialReport fr
  JOIN LastFourQuarters lfq
    ON fr.RepYear = lfq.RepYear 
    AND fr.Quarter = CONCAT('Q', lfq.QuarterCycled) 
  JOIN Company c
    ON fr.CompanyID = c.CompanyID
  WHERE c.CompanyName = userEnteredName;
  ORDER BY fr.RepYear DESC, fr.Quarter DESC; -- most recent four quarters (starting from most recent year)
 
  SELECT -- distribution of disruption event counts over past year
    dc.CategoryName,
    COUNT(de.EventID) AS EventCount
  FROM DisruptionCategory dc
  LEFT JOIN DisruptionEvent de
    ON dc.CategoryID = de.CategoryID
    AND de.EventDate .= DATE_SUB(CURDATE(), INTERVAL 1 YEAR) -- from last year
  GROUP BY dc.CategoryName
  ORDER BY EventCount DESC; -- most common disruption event descending

  SELECT -- and a list of the events
    dc.CategoryID,
    dc.CategoryName, 
    dc.Description,
    de.EventID,
    de.EventDate,
    de.EventRecoveryDate
  FROM DisruptionEvent de
  JOIN DisruptionCategory dc
    ON de.CategoryID = dc.CategoryID
  WHERE de.EventDate >= DATE_SUB(CURDATE(), INTERVAL 1 YEAR)
  ORDER BY de.EventDate DESC;





-- DISRUPTION EVENTS contains DF, ART, HDR, TD, RRC, DSD --
  -- one mandatory input of company, region, and/or tier, over a period of time (optional range, full history if not)--

CREATE PROCEDURE DisruptionEventsDisplay(
  IN userEnteredName VARCHAR(100) DEFAULT NULL,
  IN userEnteredRegion VARCHAR(50) DEFAULT NULL, 
  IN userEnteredTier ENUM('1','2','3') DEFAULT NULL,
  IN userStartDate DATE DEFAULT NULL, 
  IN userEndDate DATE DEFAULT NULL, 
)
BEGIN

  -- General Disruption Events Data -- 
  SELECT -- distribution of disruption events by category - updated from company search to include by region and/or by the tier
    dc.CategoryName, 
    COUNT(de.EventID) AS EventCount
  FROM DisruptionCategory dc
  LEFT JOIN DisruptionEvent de ON dc.CategoryID = de.CategoryID
  WHERE (de.EventDate BETWEEN COALESCE(userStartDate, '1000-01-01') AND COALESCE(userEndDate, CURRENT_DATE) 
  LEFT JOIN ImpactsCompany ic ON de.EventID = ic.EventID
  LEFT JOIN Company c ON ic.AffectedCompanyID = c.CompanyID ON ic.AffectedCompanyID = c.CompanyID
  LEFT JOIN Location l ON c.LocationID - l.LocationID
  WHERE (userEnteredName IS NULL OR c.CompanyName = userEnteredName) AND (userEnteredName IS NULL OR l.ContinentName = userEnteredRegion) AND (userEnteredTier IS NULL OR c.TierLevel = userEnteredTier)
  GROUP BY dc.CategoryName
  ORDER BY EventCount DESC;

  SELECT -- listed tabular format all disruption events
    c.CompanyName,
    c.CompanyID,
    c.TierLevel,
    l.LocationID,
    l.ContinentName,
    dc.CategoryName,
    dc.Description,
    de.EventID,
    de.EventDate,
    de.EventRecoveryDate,
    ic.ImpactLevel
  FROM DisruptionEvent de
  JOIN DisruptionCategory dc ON de.CategoryID = dc.CategoryID
  JOIN ImpactsCompany ic ON de.EventID = ic.EventID
  JOIN Company c ON ic.AffectedCompanyID = c.CompanyID
  JOIN Location l ON c.LocationID = l.LocationID
  WHERE (userEnteredName IS NULL OR c.CompanyName = userEnteredName) AND (userEnteredName IS NULL OR l.ContinentName = userEnteredRegion) AND (userEnteredTier IS NULL OR c.TierLevel = userEnteredTier) -- paired by tier if provided
  ORDER BY de.EventDate DESC;

  -- Disruption Frequency (DF) -- 
  -- observation frequency taken as T= per quarter for later bar chart--

  WITH dateRange AS (
    SELECT 
      CASE 
        WHEN userStartDate IS NOT NULL 
          THEN userStartDate
        ELSE (SELECT MIN(EventDate) FROM DisruptionEvent) -- earliest disruption default start
      END AS disruptionStartDate
      CASE
        WHEN userEndDate IS NOT NULL
          THEN userEndDate
        ELSE (SELECT MAX(EventDate) FROM DisruptionEvent) -- most recent disruption default end
      END AS disruptionEndDate
    ),

  disruptionsInRange AS ( -- finds all disruptions within the user-entered/default time range
    SELECT
      c.CompanyName,
      c.CompanyID,  
      de.EventID,
      de.EventDate,
      l.ContinentName AS Region,
      ic.ImpactLevel
    FROM DisruptionEvent de
    JOIN ImpactsCompany ic ON de.EventID = ic.EventID
    JOIN Company c ON ic.AffectedCompanyID = c.CompanyID
    JOIN Location l ON c.LocationID = l.LocationID
    JOIN dateRange dr
    WHERE de.EventDate BETWEEN dr.disruptionStartDate AND dr.disruptionEndDate AND (userEnteredName IS NULL OR c.CompanyName = userEnteredName) AND (userEnteredRegion IS NULL OR l.ContinentName = userEnteredRegion) AND (userEnteredTier IS NULL OR c.TierLevel = userEnteredTier)
  )  

  totalDisruptions AS ( -- new examined total of disruptions within the date range
    SELECT COUNT(*) AS total_disruptions FROM disruptionsInRange
  )

  quartersInRange AS ( -- calculates number of quarters and stores said quarters within the time range (since specific date dependent for resultant number of quarters)
      SELECT 
          CONCAT(YEAR(dr.disruptionStartDate), '-Q', QUARTER(dr.disruptionStartDate)) AS QuarterLabel,
          DATE_FORMAT(dr.disruptionStartDate, '%Y-%m-01') AS QuarterStart -- 01 constant since Jan 1, Apr 1, Jul 1, Oct 1 starts
      FROM dateRange dr
      UNION ALL
      SELECT 
        CONCAT(YEAR(DATE_ADD(QuarterStart, INTERVAL 3 MONTH)), -- 3 month interval breaks down to Jan 1 - Mar 31 ... etc.
          '-Q',
          QUARTER(DATE_ADD(QuarterStart, INTERVAL 3 MONTH))) AS QuarterLabel, 
        DATE_ADD(QuarterStart, INTERVAL 3 MONTH)
      FROM quartersInRange
      JOIN dateRange dr
      WHERE DATE_ADD(QuarterStart, INTERVAL 3 MONTH) <= dr.disruptionEndDate
  ),

  quarterlyCounts AS ( -- all disruptions per company for all quarters
    SELECT
      q.QuarterLabel,
      d.CompanyID,
      d.CompanyName,
      COUNT(d.EventID) AS disruptionsThisQuarter
    FROM quarterSpan q
    LEFT JOIN disruptionsInRange d ON QUARTER(d.EventDate) = SUBSTRING(q.QuarterLabel, 7, 1) AND YEAR(d.EventDate) = SUBSTRING(q.QuarterLabel, 1, 4)
    GROUP BY q.QuarterLabel, d.CompanyID, d.CompanyName
  ),

  -- Disruption Frequency (DF) --

  frequency AS ( -- disruption frequency
    SELECT
      CompanyID,
      CompanyName,
      SUM(disruptionsThisQuarter) AS Ndisruptions, -- total disruptions
      COUNT(*) AS T_quarters, -- total quarters
      SUM(disruptionsThisQuarter) / COUNT(*) AS DF -- disruption frequency
    FROM quarterlyCounts
    GROUP BY CompanyID, CompanyName
  )
  SELECT * FROM frequency
  ORDER BY DF DESC;


  -- Average Recovery Time (ART) --

  SELECT -- average time between event date (start) and event recovery date for disruption events
    CompanyName,
    CompanyID,
    ContinentName AS Region,
    COUNT(de.EventID) AS Ndisruptions,
    AVG(DATEDIFF(EventRecoveryDate, EventDate)) AS ART -- average recovery  time (in days)
  FROM disruptionsInRange
  GROUP BY CompanyID, CompanyName, Region
  ORDER BY ART ASC;


  -- High-Impact Disruption Rate --

  SELECT -- percentage of disruption events classified as high severity
    d.CompanyName,
    d.CompanyID,
    d.Region,
    COUNT(*) AS Ndisruptions, -- total disruptions
    SUM(CASE WHEN ic.ImpactLevel = 'High' THEN 1 ELSE 0 END) as NhighImpact, -- total high density disruptions
    ROUND(100 * SUM(CASE WHEN ic.ImpactLevel = 'High' THEN 1 ELSE 0 END) / COUNT(*), 3) AS HDR -- percentage
  FROM disruptionsInRange d
  JOIN ImpactsCompany
  JOIN Company c ON d.CompanyID = c.CompanyID
  JOIN Location l ON c.LocationID = l.LocationID
  GROUP BY d.CompanyID, d.CompanyName, d.Region
  ORDER BY HDR DESC;

  -- Total Downtime (TD) --

  SELECT -- summation of time between disruption event date (start) and event recovery date
    CompanyName,
    CompanyID,
    ContinentName AS Region,
    COUNT(de.EventID) as Ndisruptions,
    SUM(DATEDIFF(EventRecoveryDate, EventDate)) AS TD -- total downtime (in days)
  FROM disruptionsInRange
  GROUP BY CompanyID, CompanyName, Region
  ORDER BY TD DESC;

  -- Regional Risk Concentration (RRC) --

  SELECT -- fraction of disruptions occuring in a region (user-entered)
    Region,
    COUNT(*) AS disruptionsInRegion,
    (COUNT(*) / totalDisruptions) * 100 AS RRC -- regional risk concentration (percentage)
  FROM disruptionsInRange, totalDisruptions
  GROUP BY Region, totalDisruptions
  ORDER BY RRC DESC;

  -- Disruption Severity Distribution (DSD) -- 

  SELECT -- counts of low/medium/high severity events
    Impact Level,
    COUNT(*) AS disruptionsCount
  FROM disruptionsInRange
  Group BY ImpactLevel
  ORDER BY FIELD(ImpactLevel, 'Low', 'Medium', 'High')

END//

-- Alerts of New/Ongoing Disruptions -- 
-- design choice to display current disruptions, in order of descending recency --
-- returns disruption name, event id, event date (start), category, and impacted company (immediately, not any downstream displayed in alert) --

CREATE PROCEDURE AlertsOngoingDisruptions()
BEGIN 
  SELECT
    c.CompanyName,
    de.EventID,
    de.EventDate AS StartDate,
    dc.CategoryName
  FROM DisruptionEvent de
  JOIN DisruptionCategory dc ON de.CategoryID = dc.CategoryID
  JOIN ImpactsCompany ic ON de.EventID = ic.EventID
  JOIN Company c ON ic.AffectedCompanyID = c.CompanyID 
  WHERE de.EventRecoveryDate IS NULL OR de.EventRecoveryDate > CURRENT_DATE()
  ORDER BY de.EventDate DESC;
END//



-- Transactions Examination -- 

CREATE PROCEDURE TransactionsExamination(
  IN userStartDate DATE,
  IN userEndDate DATE,
  IN userLocation VARCHAR(100),
  IN userSourceCompany VARCHAR(100),
  IN userDestinationCompany VARCHAR(100),
  IN userDistributor VARCHAR(100)
)
BEGIN

WITH dateRange AS (
    SELECT
      COALESCE(userStartDate, (SELECT(MIN(ActualDate) FROM Shipping)) as startDate, 
      COALESCE(userEndDate, (SELECT MAX(ActualDate) FROM Shipping)) as endDate
  ),

shipments AS (
  SELECT
    s.ShipmentID,
    s.DistributorID,
    s.ProductID,
    s.SourceCompanyID, 
    s.DestinationCompanyID,
    s.ActualDate,
    s.Quantity,
    d.CompanyName AS DistributorName,
    p.ProductName,
    cs.CompanyName AS SourceCompany,
    cs.LocationID AS SourceLocation,
    cd.CompanyName AS DestinationCompany,
    cd.LocationID AS DestinationLocation,
    ls.CountryName AS SourceCountry,
    ls.ContinentName AS SourceRegion,
    ls.CityName AS SourceCity,
    ld.CountryName AS DestinationCountry,
    ld.ContinentName AS DestinationContinent,
    ld.City as DestinationCity,
  FROM Shipping s
  JOIN Company d ON s.DistributorID = d.CompanyID
  JOIN Product p ON s.ProductID = p.ProductID
  JOIN Company cs ON s.SourceCompanyID = cs.CompanyID
  JOIN Company cd ON s.DestinationCompanyID - cd.CompanyID
  JOIN Location ls ON cs.LocationID = ls.LocationID
  JOIN Location ld ON cd.LocationID = ld.LocationID
  JOIN dateRange dr
  WHERE s.ActualDate BETWEEN dr.startDate AND dr.endDate AND (userSourceCompany IS NULL OR cs.CompanyName - userSourceCompany) AND (userDestinationCompany IS NULL OR cd.CompanyName = userDestinationCompany) AND (userDistributor IS NULL OR dr.CompanyName = userDistributor) AND (userLocation IS NULL OR ls.CountryName = userLocation OR ls.ContinentName = userLocation OR ls.City = userLocation OR ld.CountryName = userLocation OR ld.ContinentName = userLocation OR ld.City = userLocation)
