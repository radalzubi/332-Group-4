CREATE PROCEDURE TransactionsExamination(
  IN userStartDate DATE,
  IN userEndDate DATE,
  IN userLocation VARCHAR(100),
  IN userSourceCompany VARCHAR(100),
  IN userDestinationCompany VARCHAR(100),
  IN userDistributor VARCHAR(100)
)
BEGIN

  -- Common date range CTE
  WITH dateRange AS (
    SELECT
      COALESCE(userStartDate, (SELECT MIN(ActualDate) FROM Shipping)) AS startDate,
      COALESCE(userEndDate,   (SELECT MAX(ActualDate) FROM Shipping)) AS endDate
  ),

  -- Shipments matching filters
  shipments AS (
    SELECT
      s.ShipmentID,
      s.DistributorID,
      d.CompanyName AS DistributorName,
      s.ProductID,
      p.ProductName,
      p.Category,
      s.SourceCompanyID,
      cs.CompanyName AS SourceCompany,
      cs.LocationID AS SourceLocation,
      ls.CountryName AS SourceCountry,
      ls.ContinentName AS SourceRegion,
      ls.CityName AS SourceCity,
      s.DestinationCompanyID,
      cd.CompanyName AS DestinationCompany,
      cd.LocationID AS DestinationLocation,
      ld.CountryName AS DestinationCountry,
      ld.ContinentName AS DestinationContinent,
      ld.CityName AS DestinationCity,
      s.ActualDate,
      s.PromisedDate,
      s.Quantity
    FROM Shipping s
    JOIN Company d  ON s.DistributorID      = d.CompanyID
    JOIN Product p  ON s.ProductID          = p.ProductID
    JOIN Company cs ON s.SourceCompanyID    = cs.CompanyID
    JOIN Company cd ON s.DestinationCompanyID = cd.CompanyID
    JOIN Location ls ON cs.LocationID = ls.LocationID
    JOIN Location ld ON cd.LocationID = ld.LocationID
    CROSS JOIN dateRange dr
    WHERE s.ActualDate BETWEEN dr.startDate AND dr.endDate
      AND (userSourceCompany      IS NULL OR cs.CompanyName = userSourceCompany)
      AND (userDestinationCompany IS NULL OR cd.CompanyName = userDestinationCompany)
      AND (userDistributor        IS NULL OR d.CompanyName = userDistributor)
      AND (
           userLocation IS NULL
        OR ls.CountryName   = userLocation
        OR ls.ContinentName = userLocation
        OR ls.CityName      = userLocation
        OR ld.CountryName   = userLocation
        OR ld.ContinentName = userLocation
        OR ld.CityName      = userLocation
      )
  ),

  -- Receivings tied to shipments in the date range and filters
  receivings AS (
    SELECT
      r.ReceivingID,
      r.TransactionID,
      r.ShipmentID,
      r.ReceiverCompanyID,
      c.CompanyName AS ReceiverCompany,
      r.ReceivedDate,
      r.QuantityReceived,
      s.SourceCompanyID,
      s.DestinationCompanyID,
      s.DistributorID,
      s.ProductID,
      s.ActualDate
    FROM Receiving r
    JOIN Shipping s ON r.ShipmentID = s.ShipmentID
    JOIN Company c   ON r.ReceiverCompanyID = c.CompanyID
    CROSS JOIN dateRange dr
    WHERE s.ActualDate BETWEEN dr.startDate AND dr.endDate
      AND (userSourceCompany      IS NULL OR s.SourceCompanyID = (SELECT CompanyID FROM Company WHERE CompanyName = userSourceCompany LIMIT 1))
      AND (userDestinationCompany IS NULL OR r.ReceiverCompanyID = (SELECT CompanyID FROM Company WHERE CompanyName = userDestinationCompany LIMIT 1))
      AND (userDistributor        IS NULL OR s.DistributorID = (SELECT CompanyID FROM Company WHERE CompanyName = userDistributor LIMIT 1))
  ),

  -- Inventory adjustments in date range
  adjustments AS (
    SELECT
      a.AdjustmentID,
      a.TransactionID,
      a.CompanyID,
      c.CompanyName,
      a.ProductID,
      p.ProductName,
      a.AdjustmentDate,
      a.QuantityChange,
      a.Reason
    FROM InventoryAdjustment a
    JOIN Company c ON a.CompanyID = c.CompanyID
    JOIN Product p ON a.ProductID = p.ProductID
    CROSS JOIN dateRange dr
    WHERE a.AdjustmentDate BETWEEN dr.startDate AND dr.endDate
      AND (userSourceCompany      IS NULL OR a.CompanyID = (SELECT CompanyID FROM Company WHERE CompanyName = userSourceCompany LIMIT 1))
      AND (userDestinationCompany IS NULL OR a.CompanyID = (SELECT CompanyID FROM Company WHERE CompanyName = userDestinationCompany LIMIT 1))
      AND (userDistributor        IS NULL OR a.CompanyID = (SELECT CompanyID FROM Company WHERE CompanyName = userDistributor LIMIT 1))
  ),

  -- Shipment status derived from shipments
  statusOfShipments AS (
    SELECT
      s.*,
      CASE
        WHEN s.ActualDate IS NULL THEN 'Currently Out on Delivery'
        WHEN s.ActualDate <= s.PromisedDate THEN 'On Time Delivery'
        ELSE 'Late Delivery'
      END AS DeliveryStatus,
      DATEDIFF(s.ActualDate, s.PromisedDate) AS daysDelayed
    FROM shipments s
  ),

  -- Products handled per distributor (aggregated)
  productsHandled AS (
    SELECT
      s.DistributorID,
      s.DistributorName,
      s.ProductID,
      s.ProductName,
      s.Category,
      sp.SupplyPrice,
      COUNT(*)                 AS NumShipments,
      SUM(s.Quantity)          AS TotalQuantity
    FROM statusOfShipments s
    LEFT JOIN Product p ON s.ProductID = p.ProductID
    LEFT JOIN SuppliesProduct sp ON sp.ProductID = s.ProductID AND sp.SupplierID = s.DistributorID
    GROUP BY s.DistributorID, s.DistributorName, s.ProductID, s.ProductName, s.Category, sp.SupplyPrice
  ),

  -- Disruption exposure per distributor (assumes DisruptionEvent.EventDate and ImpactsCompany.ImpactLevel exist)
  findDisruptionExposure AS (
    SELECT
      d.CompanyID,
      d.CompanyName,
      COUNT(DISTINCT de.EventID) AS Ndisruptions,
      (COUNT(DISTINCT de.EventID) + 2 * COALESCE(SUM(CASE WHEN ic.ImpactLevel = 'High' THEN 1 ELSE 0 END),0)) AS disruptionExposure
    FROM Distributor d
    LEFT JOIN ImpactsCompany ic ON d.CompanyID = ic.AffectedCompanyID
    LEFT JOIN DisruptionEvent de ON ic.EventID = de.EventID
    CROSS JOIN dateRange dr
    WHERE (de.EventDate BETWEEN dr.startDate AND dr.endDate OR de.EventDate IS NULL)
    GROUP BY d.CompanyID, d.CompanyName
  )

  -- Final combined transaction view (normalized columns so UNION works)
  SELECT
    'Shipping' AS TransactionType,
    s.ShipmentID           AS ShipmentID,
    NULL                   AS ReceivingID,
    NULL                   AS AdjustmentID,
    s.DistributorID,
    s.DistributorName,
    s.ProductID,
    s.ProductName,
    s.SourceCompanyID,
    s.SourceCompany,
    s.DestinationCompanyID,
    s.DestinationCompany,
    s.ActualDate AS EventDate,
    NULL         AS ReceivedDate,
    NULL         AS AdjustmentDate,
    s.Quantity   AS Quantity,
    NULL         AS QuantityReceived,
    NULL         AS QuantityChange,
    s.DeliveryStatus,
    s.daysDelayed
  FROM statusOfShipments s

  UNION ALL

  SELECT
    'Receiving' AS TransactionType,
    r.ShipmentID,
    r.ReceivingID,
    NULL,
    r.DistributorID,
    NULL,
    r.ProductID,
    NULL,
    r.SourceCompanyID,
    NULL,
    r.DestinationCompanyID,
    NULL,
    r.ActualDate AS EventDate,
    r.ReceivedDate,
    NULL,
    NULL,
    r.QuantityReceived,
    NULL,
    NULL,
    NULL
  FROM receivings r

  UNION ALL

  SELECT
    'Adjustment' AS TransactionType,
    NULL AS ShipmentID,
    NULL AS ReceivingID,
    a.AdjustmentID,
    a.CompanyID AS DistributorID,
    a.CompanyName AS DistributorName,
    a.ProductID,
    a.ProductName,
    NULL, NULL, NULL, NULL,
    a.AdjustmentDate AS EventDate,
    NULL, -- ReceivedDate
    a.AdjustmentDate AS AdjustmentDate,
    NULL, -- Quantity (shipment)
    NULL, -- QuantityReceived
    a.QuantityChange,
    NULL, -- DeliveryStatus
    NULL  -- daysDelayed
  FROM adjustments a

  ORDER BY TransactionType, EventDate, ReceivedDate, AdjustmentDate;


  -- -----------------------
  -- Distributor-specific summary and plots-ready queries
  -- -----------------------
  IF userDistributor IS NOT NULL THEN

    -- 1) High-level distributor summary (shipments)
    SELECT
      ph.DistributorName,
      COUNT(DISTINCT s.ShipmentID)            AS shipmentCount,
      COALESCE(SUM(s.Quantity),0)             AS shipmentVolume,
      ROUND(100 * COALESCE(SUM(CASE WHEN s.DeliveryStatus = 'On Time Delivery' THEN 1 ELSE 0 END),0) / GREATEST(COUNT(*),1), 4) AS onTimeDeliveryRate_pct,
      SUM(CASE WHEN s.DeliveryStatus = 'Currently Out on Delivery' THEN 1 ELSE 0 END) AS shipmentsOutOnDelivery,
      SUM(CASE WHEN s.DeliveryStatus = 'Late Delivery' THEN 1 ELSE 0 END) AS lateShipments,
      SUM(CASE WHEN s.DeliveryStatus = 'On Time Delivery' THEN 1 ELSE 0 END) AS onTimeShipments
    FROM statusOfShipments s
    JOIN productsHandled ph ON ph.DistributorID = s.DistributorID
    WHERE ph.DistributorName = userDistributor
    GROUP BY ph.DistributorName;

    -- 2) Products handled (list form)
    SELECT
      ph.ProductName,
      ph.Category,
      ph.SupplyPrice,
      ph.NumShipments,
      ph.TotalQuantity,
      (ph.SupplyPrice * ph.TotalQuantity) AS TotalRevenuePerProduct
    FROM productsHandled ph
    WHERE ph.DistributorName = userDistributor
    ORDER BY ph.ProductName;

    -- 3) Aggregates (total NumShipments, TotalQuantity, TotalRevenue) for this distributor
    SELECT
      ph.DistributorName,
      SUM(ph.NumShipments)     AS TotalNumShipments,
      SUM(ph.TotalQuantity)    AS TotalQuantity,
      SUM(COALESCE(ph.SupplyPrice,0) * ph.TotalQuantity) AS TotalRevenue
    FROM productsHandled ph
    WHERE ph.DistributorName = userDistributor
    GROUP BY ph.DistributorName;

    -- 4) Number of shipments per category (for plotting)
    SELECT
      ph.Category,
      SUM(ph.NumShipments)     AS NumShipments,
      SUM(ph.TotalQuantity)    AS TotalQuantity
    FROM productsHandled ph
    WHERE ph.DistributorName = userDistributor
    GROUP BY ph.Category
    ORDER BY ph.Category;

    -- 5) Revenue per category (for plotting)
    SELECT
      ph.Category,
      SUM(COALESCE(ph.SupplyPrice,0) * ph.TotalQuantity) AS TotalRevenue
    FROM productsHandled ph
    WHERE ph.DistributorName = userDistributor
    GROUP BY ph.Category
    ORDER BY TotalRevenue DESC;

    -- 6) Price distribution of products handled by distributor
    SELECT
      ph.ProductName,
      ph.Category,
      ph.SupplyPrice,
      ph.TotalQuantity
    FROM productsHandled ph
    WHERE ph.DistributorName = userDistributor
    ORDER BY ph.SupplyPrice ASC;

    -- 7) Disruption exposure summary for this distributor
    SELECT
      f.CompanyName,
      f.Ndisruptions,
      f.disruptionExposure
    FROM findDisruptionExposure f
    WHERE f.CompanyName = userDistributor;

    -- 8) Disruption counts by category (added per your request).
    -- Assumes DisruptionEvent has columns EventID, Category, EventDate and ImpactsCompany links event -> affected company.
    SELECT
      COALESCE(de.Category, 'Uncategorized') AS EventCategory,
      COUNT(DISTINCT de.EventID) AS NumEvents,
      SUM(CASE WHEN ic.ImpactLevel = 'High' THEN 1 ELSE 0 END) AS NumHighImpactEvents
    FROM Distributor d
    LEFT JOIN ImpactsCompany ic ON d.CompanyID = ic.AffectedCompanyID
    LEFT JOIN DisruptionEvent de ON ic.EventID = de.EventID
    CROSS JOIN dateRange dr
    WHERE d.CompanyName = userDistributor
      AND (de.EventDate BETWEEN dr.startDate AND dr.endDate OR de.EventDate IS NULL)
    GROUP BY de.Category
    ORDER BY NumEvents DESC;

  END IF;

END$$

DELIMITER ;







