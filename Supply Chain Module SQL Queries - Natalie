CREATE PROCEDURE CompanyInfoSearch(
  IN userEnteredName VARCHAR(100),
  IN userStartDate DATE,
  IN userEndDate DATE
)
BEGIN

  /* ===============================
     BASIC COMPANY INFO
     =============================== */
  SELECT *
  FROM Company
  WHERE CompanyName = userEnteredName;

  /* ===============================
     COMPANY LOCATION
     =============================== */
  SELECT
    c.CompanyID,
    c.CompanyName,
    l.City,
    l.CountryName,
    l.ContinentName
  FROM Company c
  JOIN Location l ON c.LocationID = l.LocationID
  WHERE c.CompanyName = userEnteredName;

  /* ===============================
     DEPENDENCY RELATIONSHIPS
     =============================== */
  SELECT
    c.CompanyID AS BaseCompanyID,
    depUp.CompanyID AS UpstreamCompanyID,
    depUp.CompanyName AS UpstreamCompanyName,
    depDown.CompanyID AS DownstreamCompanyID,
    depDown.CompanyName AS DownstreamCompanyName
  FROM Company c
  LEFT JOIN DependsOn d1 
    ON c.CompanyID = d1.DownstreamCompanyID
  LEFT JOIN Company depUp 
    ON d1.UpstreamCompanyID = depUp.CompanyID
  LEFT JOIN DependsOn d2 
    ON c.CompanyID = d2.UpstreamCompanyID
  LEFT JOIN Company depDown 
    ON d2.DownstreamCompanyID = depDown.CompanyID
  WHERE c.CompanyName = userEnteredName;

  /* ===============================
     MOST RECENT FINANCIAL REPORT
     =============================== */
  SELECT f.*
  FROM FinancialReport f
  JOIN Company c ON f.CompanyID = c.CompanyID
  WHERE c.CompanyName = userEnteredName
  ORDER BY 
    f.RepYear DESC,
    FIELD(f.Quarter, 'Q4','Q3','Q2','Q1') DESC
  LIMIT 1;

  /* ===============================
     PRODUCTS SUPPLIED
     =============================== */
  SELECT
    p.ProductID,
    p.ProductName,
    sp.SupplyPrice
  FROM SuppliesProduct sp
  JOIN Product p ON sp.ProductID = p.ProductID
  JOIN Company c ON sp.SupplierID = c.CompanyID
  WHERE c.CompanyName = userEnteredName;

  /* ===============================
     PRODUCT DIVERSITY
     =============================== */
  SELECT
    p.Category,
    COUNT(*) AS TotalProductNumber,
    ROUND(
      COUNT(*) * 100.0 / (
        SELECT COUNT(*) FROM SuppliesProduct sp2
        JOIN Company c2 ON sp2.SupplierID = c2.CompanyID
        WHERE c2.CompanyName = userEnteredName
      ), 2
    ) AS PercentOfTotalProducts
  FROM SuppliesProduct sp
  JOIN Product p ON sp.ProductID = p.ProductID
  JOIN Company c ON sp.SupplierID = c.CompanyID
  WHERE c.CompanyName = userEnteredName
  GROUP BY p.Category;

  /* ===============================
     SHIPPING TRANSACTIONS
     =============================== */
  SELECT
    t.TransactionID,
    'Shipping' AS TransactionType,
    s.SourceCompanyID,
    s.DestinationCompanyID,
    s.Quantity,
    s.ActualDate AS TransactionDate,
    p.ProductName
  FROM InventoryTransaction t
  JOIN Shipping s 
    ON t.TransactionID = s.TransactionID
  JOIN Product p 
    ON s.ProductID = p.ProductID
  JOIN Company c 
    ON (s.SourceCompanyID = c.CompanyID 
     OR s.DestinationCompanyID = c.CompanyID)
  WHERE c.CompanyName = userEnteredName
    AND s.ActualDate BETWEEN 
        COALESCE(userStartDate, '1000-01-01') 
        AND COALESCE(userEndDate, CURRENT_DATE)
  ORDER BY s.ActualDate DESC;

  /* ===============================
     RECEIVING TRANSACTIONS
     =============================== */
  SELECT
    t.TransactionID,
    'Receiving' AS TransactionType,
    r.ReceivedDate AS TransactionDate,
    r.QuantityReceived AS Quantity,
    r.ReceiverCompanyID,
    s.SourceCompanyID,
    p.ProductName
  FROM InventoryTransaction t
  JOIN Receiving r 
    ON t.TransactionID = r.TransactionID
  JOIN Shipping s 
    ON r.ShipmentID = s.ShipmentID
  JOIN Product p 
    ON s.ProductID = p.ProductID
  JOIN Company c 
    ON r.ReceiverCompanyID = c.CompanyID
  WHERE c.CompanyName = userEnteredName
    AND r.ReceivedDate BETWEEN 
        COALESCE(userStartDate, '1000-01-01') 
        AND COALESCE(userEndDate, CURRENT_DATE)
  ORDER BY r.ReceivedDate DESC;

  /* ===============================
     INVENTORY ADJUSTMENTS
     =============================== */
  SELECT
    t.TransactionID,
    'Adjustment' AS TransactionType,
    a.AdjustmentDate,
    a.QuantityChange,
    a.CompanyID,
    p.ProductName,
    a.Reason
  FROM InventoryTransaction t
  JOIN InventoryAdjustment a 
    ON t.TransactionID = a.TransactionID
  JOIN Product p 
    ON a.ProductID = p.ProductID
  JOIN Company c 
    ON a.CompanyID = c.CompanyID
  WHERE c.CompanyName = userEnteredName
    AND a.AdjustmentDate BETWEEN 
        COALESCE(userStartDate, '1000-01-01') 
        AND COALESCE(userEndDate, CURRENT_DATE)
  ORDER BY a.AdjustmentDate DESC;

  /* ===================================================
     KPI SECTION (Only meaningful for Distributors)
     =================================================== */

  WITH distributorShipments AS (
    SELECT
      s.ShipmentID,
      s.PromisedDate,
      s.ActualDate,
      DATEDIFF(s.ActualDate, s.PromisedDate) AS daysDelayed
    FROM Shipping s
    JOIN Company c 
      ON s.DistributorID = c.CompanyID
    WHERE c.CompanyName = userEnteredName 
      AND c.Type = 'Distributor'
      AND s.ActualDate BETWEEN 
          COALESCE(userStartDate, '1000-01-01') 
          AND COALESCE(userEndDate, CURRENT_DATE)
  )

  SELECT 
    c.CompanyName,
    c.Type AS CompanyType,

    -- On-time delivery rate
    CASE 
      WHEN c.Type = 'Distributor' THEN (
        SELECT ROUND(
          100.0 * SUM(CASE WHEN ActualDate <= PromisedDate THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0),
          4
        )
        FROM distributorShipments
      )
      ELSE NULL
    END AS OnTimeDeliveryRate,

    -- Average delay
    CASE 
      WHEN c.Type = 'Distributor' THEN (
        SELECT ROUND(AVG(daysDelayed), 4)
        FROM distributorShipments
      )
      ELSE NULL
    END AS AverageDelay,

    -- Standard deviation of delay
    CASE 
      WHEN c.Type = 'Distributor' THEN (
        SELECT ROUND(STDDEV_POP(daysDelayed), 4)
        FROM distributorShipments
      )
      ELSE NULL
    END AS StandardDeviationDelay

  FROM Company c
  WHERE c.CompanyName = userEnteredName;

  /* ===================================================
     LAST 4 QUARTERS FINANCIAL HEALTH
     =================================================== */

  WITH LastFourQuarters AS (
    SELECT
      CONCAT('Q', MOD(QUARTER(CURDATE()) - n - 1 + 4, 4) + 1) AS Quarter,
      YEAR(CURDATE()) - IF(QUARTER(CURDATE()) - n <= 0, 1, 0) AS RepYear
    FROM (
      SELECT 0 AS n UNION ALL 
      SELECT 1 UNION ALL 
      SELECT 2 UNION ALL 
      SELECT 3
    ) AS offsets
  )

  SELECT 
    c.CompanyName,
    fr.CompanyID,
    fr.Quarter,
    fr.RepYear,
    fr.HealthScore
  FROM FinancialReport fr
  JOIN LastFourQuarters lfq
    ON fr.RepYear = lfq.RepYear 
    AND fr.Quarter = lfq.Quarter
  JOIN Company c
    ON fr.CompanyID = c.CompanyID
  WHERE c.CompanyName = userEnteredName
  ORDER BY fr.RepYear DESC, fr.Quarter DESC;

  /* ===================================================
     DISTRIBUTION OF DISRUPTION EVENTS (PAST YEAR)
     =================================================== */

  SELECT 
    dc.CategoryName,
    COUNT(de.EventID) AS EventCount
  FROM DisruptionCategory dc
  LEFT JOIN DisruptionEvent de
    ON dc.CategoryID = de.CategoryID
    AND de.EventDate >= DATE_SUB(CURDATE(), INTERVAL 1 YEAR)
  GROUP BY dc.CategoryName
  ORDER BY EventCount DESC;

  /* ===================================================
     DISRUPTION EVENT LIST (PAST YEAR)
     =================================================== */

  SELECT
    dc.CategoryID,
    dc.CategoryName, 
    dc.Description,
    de.EventID,
    de.EventDate,
    de.EventRecoveryDate
  FROM DisruptionEvent de
  JOIN DisruptionCategory dc
    ON de.CategoryID = dc.CategoryID
  WHERE de.EventDate >= DATE_SUB(CURDATE(), INTERVAL 1 YEAR)
  ORDER BY de.EventDate DESC;

END //

