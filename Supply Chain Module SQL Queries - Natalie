CREATE PROCEDURE CompanyInfoSearch(
  IN userEnteredName VARCHAR(100),
  IN userStartDate DATE,
  IN userEndDate DATE
)
BEGIN

  /* BASIC COMPANY INFO */
  SELECT c.*
  FROM Company c
  WHERE c.CompanyName = userEnteredName;

  /* ADDRESS */
  SELECT
    c.CompanyID,
    c.CompanyName,
    l.City,
    l.CountryName,
    l.ContinentName
  FROM Company c
  JOIN Location l ON l.LocationID = c.LocationID
  WHERE c.CompanyName = userEnteredName;

  /* DEPENDENCY RELATIONSHIPS */
  SELECT
    c.CompanyID AS BaseCompanyID,
    depUp.CompanyID AS UpstreamCompanyID,
    depUp.CompanyName AS UpstreamCompanyName,
    depDown.CompanyID AS DownstreamCompanyID,
    depDown.CompanyName AS DownstreamCompanyName
  FROM Company c
  LEFT JOIN DependsOn d1 
    ON c.CompanyID = d1.DownstreamCompanyID
  LEFT JOIN Company depUp 
    ON d1.UpstreamCompanyID = depUp.CompanyID
  LEFT JOIN DependsOn d2 
    ON c.CompanyID = d2.UpstreamCompanyID
  LEFT JOIN Company depDown 
    ON d2.DownstreamCompanyID = depDown.CompanyID
  WHERE c.CompanyName = userEnteredName;

  /* MOST RECENT FINANCIAL REPORT */
  SELECT f.*
  FROM FinancialReport f
  JOIN Company c ON f.CompanyID = c.CompanyID
  WHERE c.CompanyName = userEnteredName
  ORDER BY 
    f.RepYear DESC,
    FIELD(f.Quarter, 'Q4','Q3','Q2','Q1') DESC
  LIMIT 1;

  /* MANUFACTURER CAPACITY */
  SELECT
    m.CompanyID,
    m.FactoryCapacity
  FROM Manufacturer m
  JOIN Company c ON c.CompanyID = m.CompanyID
  WHERE c.CompanyName = userEnteredName;

  /* DISTRIBUTOR ROUTES */
  SELECT DISTINCT
    d.CompanyID,
    o.FromCompanyID,
    o.ToCompanyID
  FROM Distributor d
  JOIN Company c ON c.CompanyID = d.CompanyID
  LEFT JOIN OperatesLogistics o ON o.DistributorID = d.CompanyID
  WHERE c.CompanyName = userEnteredName;

  /* PRODUCTS SUPPLIED */
  SELECT
    p.ProductID,
    p.ProductName,
    sp.SupplyPrice
  FROM SuppliesProduct sp
  JOIN Product p ON sp.ProductID = p.ProductID
  JOIN Company c ON sp.SupplierID = c.CompanyID
  WHERE c.CompanyName = userEnteredName;

  /* PRODUCT DIVERSITY */
  SELECT
    p.Category,
    COUNT(*) AS TotalProductNumber,
    ROUND(
      COUNT(*) * 100.0 / (
        SELECT COUNT(*) 
        FROM SuppliesProduct 
        WHERE SupplierID = c.CompanyID
      ), 2
    ) AS PercentOfTotalProducts
  FROM SuppliesProduct sp
  JOIN Product p ON sp.ProductID = p.ProductID
  JOIN Company c ON sp.SupplierID = c.CompanyID
  WHERE c.CompanyName = userEnteredName
  GROUP BY p.Category;

  /* SHIPPING TRANSACTIONS */
  SELECT
    t.TransactionID,
    'Shipping' AS TransactionType,
    s.SourceCompanyID,
    s.DestinationCompanyID,
    s.Quantity,
    s.ActualDate AS TransactionDate,
    p.ProductName
  FROM InventoryTransaction t
  JOIN Shipping s ON t.TransactionID = s.TransactionID
  JOIN Product p ON s.ProductID = p.ProductID
  JOIN Company c 
    ON (s.SourceCompanyID = c.CompanyID OR s.DestinationCompanyID = c.CompanyID)
  WHERE c.CompanyName = userEnteredName
    AND s.ActualDate BETWEEN 
        COALESCE(userStartDate, '1000-01-01') 
        AND COALESCE(userEndDate, CURRENT_DATE)
  ORDER BY s.ActualDate DESC;

  /* RECEIVING TRANSACTIONS */
  SELECT
    t.TransactionID,
    'Receiving' AS TransactionType,
    r.ReceivedDate AS TransactionDate,
    r.QuantityReceived AS Quantity,
    r.ReceiverCompanyID,
    s.SourceCompanyID,
    p.ProductName
  FROM InventoryTransaction t
  JOIN Receiving r ON t.TransactionID = r.TransactionID
  JOIN Shipping s ON r.ShipmentID = s.ShipmentID
  JOIN Product p ON s.ProductID = p.ProductID
  JOIN Company c ON r.ReceiverCompanyID = c.CompanyID
  WHERE c.CompanyName = userEnteredName
    AND r.ReceivedDate BETWEEN 
        COALESCE(userStartDate, '1000-01-01') 
        AND COALESCE(userEndDate, CURRENT_DATE)
  ORDER BY r.ReceivedDate DESC;

  /* ADJUSTMENTS */
  SELECT
    t.TransactionID,
    'Adjustment' AS TransactionType,
    a.AdjustmentDate,
    a.QuantityChange,
    a.CompanyID,
    p.ProductName,
    a.Reason
  FROM InventoryTransaction t
  JOIN InventoryAdjustment a ON t.TransactionID = a.TransactionID
  JOIN Product p ON a.ProductID = p.ProductID
  JOIN Company c ON a.CompanyID = c.CompanyID
  WHERE c.CompanyName = userEnteredName
    AND a.AdjustmentDate BETWEEN 
        COALESCE(userStartDate, '1000-01-01') 
        AND COALESCE(userEndDate, CURRENT_DATE)
  ORDER BY a.AdjustmentDate DESC;

END//

