--- Average Financial Health --- 
-- sorted from highest to lowest over user-defined time period -- 
-- optional date selection for user-defined time period, default all -- 
-- optional type of company restriction (from Piazza question 200) --

DELIMITER //

CREATE PROCEDURE avgFinancialHealthByCompany(
    IN startDate DATE, -- user-entered
    IN endDate DATE -- user-entered
)
BEGIN
    SELECT 
        c.CompanyID,
        c.CompanyName,
        c.Type AS CompanyType,
        AVG(f.HealthScore) AS avgHealthScore
    FROM Company c
    JOIN FinancialReport f
      ON c.CompanyID = f.CompanyID
    WHERE
        STR_TO_DATE(
            CONCAT(
                f.RepYear, '-',
                CASE f.Quarter
                    WHEN 'Q1' THEN '01-01' -- from Piazza Q1 January 1st through March 31st, etc.
                    WHEN 'Q2' THEN '04-01'
                    WHEN 'Q3' THEN '07-01' 
                    WHEN 'Q4' THEN '10-01'
                END
            ),
            '%Y-%m-%d'
        )
        BETWEEN startDate AND endDate
    GROUP BY 
        c.CompanyID,
        c.CompanyName, -- for financial health by company
        c.Type -- for financial health by type of company
    ORDER BY avgHealthScore DESC; -- sorted from highest to lowest
END;
//

DELIMITER ;

-- Regional Disruption Overview -- 
-- total disruptions (high, medium, low) and total high impact disruptions by region, sorted -- 
-- assumptions: region is continent, no user-specified dates needed (not in A3 listed req)

DELIMITER //

CREATE PROCEDURE regionalDisruptionOverview()
BEGIN
    SELECT
        l.ContinentName,
        COUNT(ic.EventID) AS TotalDisruptions,
        SUM(
            CASE 
                WHEN ic.ImpactLevel = 'High' THEN 1 
                ELSE 0 
            END
        ) AS HighImpactDisruptions
    FROM DisruptionEvent de
    JOIN ImpactsCompany ic ON de.EventID = ic.EventID
    JOIN Company c ON ic.AffectedCompanyID = c.CompanyID
    JOIN Location l ON c.LocationID = l.LocationID
    GROUP BY l.ContinentName
    ORDER BY
        TotalDisruptions DESC, -- total disruptions by region, sorted
        HighImpactDisruptions DESC; -- total high impact disruptions by region, sorted 
END;
//

DELIMITER ;

-- Most Critical Companies --
-- sorted, criticality = (# downstream companies (all downstream are assumed to be affected)) * (high impact count) -- 

DELIMITER //

CREATE PROCEDURE mostCriticalCompanies()
BEGIN
    SELECT
        c.CompanyID,
        c.CompanyName,
        c.Type,
        COUNT(DISTINCT d.DownstreamCompanyID) AS downstreamCount, -- # downstream companies affected
        COUNT(DISTINCT CASE 
            WHEN ic.ImpactLevel = 'High' THEN ic.EventID -- high impact count
        END) AS HighImpactCount,
        (
            COUNT(DISTINCT d.DownstreamCompanyID) *
            COUNT(DISTINCT CASE 
                WHEN ic.ImpactLevel = 'High' THEN ic.EventID 
            END)
        ) AS criticality -- criticality of i calculation
    FROM Company c
    LEFT JOIN DependsOn d ON c.CompanyID = d.UpstreamCompanyID
    LEFT JOIN ImpactsCompany ic ON c.CompanyID = ic.AffectedCompanyID
    LEFT JOIN DisruptionEvent de ON ic.EventID = de.EventID
    GROUP BY
        c.CompanyID,
        c.CompanyName,
        c.Type
    ORDER BY criticality DESC; -- most critical companies sorted
END;
//

DELIMITER ;

-- Disruption Frequency Over Time -- 

DELIMITER //

CREATE PROCEDURE disruptionFrequency(
    IN startDate DATE,
    IN endDate DATE
)
BEGIN
    SELECT
        EventDate,
        COUNT(EventID) AS TotalDisruptions
    FROM DisruptionEvent
    WHERE EventDate BETWEEN startDate AND endDate
    GROUP BY EventDate
    ORDER BY EventDate ASC; -- from start date to end date
END;
//

DELIMITER ;


-- Company Financials by Region --
-- from Piazza question 247, user-select region (continent), returns average financial health and all companies w all of their respective scores --

DELIMITER //

CREATE PROCEDURE CompanyFinancialsByRegion(
    IN selectedRegion VARCHAR(50)
)
BEGIN
    SELECT
        l.ContinentName,
        l.CountryName,
        c.CompanyID,
        c.CompanyName,
        c.Type AS CompanyType,
        f.RepYear,
        f.Quarter,
        f.HealthScore,
        (SELECT AVG(f2.HealthScore)
         FROM Company c2
         JOIN Location l2 ON c2.LocationID = l2.LocationID
         JOIN FinancialReport f2 ON c2.CompanyID = f2.CompanyID
         WHERE l2.ContinentName = selectedRegion
        ) AS AvgHealthScoreByRegion
    FROM Company c
    JOIN Location l ON c.LocationID = l.LocationID
    JOIN FinancialReport f ON c.CompanyID = f.CompanyID
    WHERE l.ContinentName = selectedRegion
    ORDER BY c.CompanyName, f.RepYear, f.Quarter;
END;
//

